# Локальное приложение и хранение данных
APP_ENV='local'
APP_HOST='127.0.0.1'
APP_PORT='18763'
APP_BASE_URL='http://127.0.0.1:18763'
APP_TIMEZONE='Europe/Moscow'
LOG_LEVEL='INFO'
DATABASE_URL='sqlite+aiosqlite:///./data/ai-inbox.sqlite3'
MEDIA_DIR='./data/media'

# Вход в приложение: отдельные логин, пароль и настройки JWT
AUTH_USERNAME='admin'
AUTH_PASSWORD='replace-with-local-login-password'
JWT_SECRET_KEY='replace-with-random-secret-at-least-32-bytes'
JWT_ALGORITHM='HS256'
JWT_ISSUER='ai-inbox-local'
JWT_AUDIENCE='ai-inbox'
ACCESS_TOKEN_EXPIRE_MINUTES='60'
AUTH_COOKIE_NAME='ai_inbox_access'
AUTH_COOKIE_SECURE='false'

# AnyModel: выбранные модели; резервная LLM по умолчанию отключена
BASE_URL='https://anymodel.org/v1'
MAIN_KEY='replace-with-anymodel-key'
LLM_MODEL='ag/gemini-3.8-flash-low'
LLM_FALLBACK_MODEL='cx/gpt-6.1-terra'
LLM_FALLBACK_ENABLED='false'
ASR_MODEL='dg/nova-3'
ASR_FALLBACK_MODEL='dg/nova-2'
ASR_LANGUAGE='ru'
TTS_MODEL='anyvoice/builtin-7'
AI_TIMEOUT_SECONDS='120'
# false: прямое подключение AnyModel без HTTP(S)_PROXY / ALL_PROXY и SSL_CERT_* из окружения
ANYMODEL_TRUST_ENV='true'
AI_MAX_ATTEMPTS='2'
AGENT_MAX_TURNS='8'

# Почта Mail.ru: пароль приложения и подключение через TLS
MAIL_USER='your-mailbox@mail.ru'
MAIL_PASS='replace-with-mail-app-password'
MAIL_IMAP_HOST='imap.mail.ru'
MAIL_IMAP_PORT='993'
MAIL_SMTP_HOST='smtp.mail.ru'
MAIL_SMTP_PORT='465'
MAIL_TIMEOUT_SECONDS='30'
MAIL_FETCH_LIMIT='20'

# Ежедневный дайджест: компьютер и приложение должны быть запущены
DIGEST_ENABLED='true'
DIGEST_HOUR='9'
DIGEST_MINUTE='0'
DIGEST_MISFIRE_GRACE_SECONDS='3600'

# Ограничения загрузки и срок хранения аудио
MAX_UPLOAD_MB='20'
AUDIO_RETENTION_DAYS='7'
